#!/bin/sh
set -e

DKMS_NAME=amd_hsmp
DKMS_PACKAGE_NAME=amd-hsmp-dkms
DKMS_VERSION=2.4
MODULES_LOAD_CONF=/etc/modules-load.d/amd_hsmp.conf

has_acpi_hsmp_device()
{
	for device in /sys/bus/acpi/devices/AMDI0097:*; do
		[ -e "$device" ] && return 0
	done

	return 1
}

first_cpuinfo_value()
{
	awk -F: -v key="$1" '$1 ~ key { gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit }' /proc/cpuinfo 2>/dev/null || true
}

is_legacy_hsmp_platform()
{
	family=$(first_cpuinfo_value '^cpu family[ \t]*$')
	model=$(first_cpuinfo_value '^model[ \t]*$')

	case "$family:$model" in
		*[!0-9:]* | :* | *:)
			return 1
			;;
	esac

	if [ "$family" -eq 25 ]; then
		if { [ "$model" -ge 0 ] && [ "$model" -le 31 ]; } ||
		   { [ "$model" -ge 48 ] && [ "$model" -le 63 ]; } ||
		   { [ "$model" -ge 144 ] && [ "$model" -le 159 ]; } ||
		   { [ "$model" -ge 160 ] && [ "$model" -le 175 ]; }; then
			return 0
		fi
	elif [ "$family" -eq 26 ]; then
		if [ "$model" -ge 0 ] && [ "$model" -le 15 ]; then
			return 0
		fi
	fi

	return 1
}

select_hsmp_frontend()
{
	if has_acpi_hsmp_device; then
		echo hsmp_acpi
	elif is_legacy_hsmp_platform; then
		echo amd_hsmp
	else
		echo hsmp_acpi
	fi
}

configure_module_autoload()
{
	module=$(select_hsmp_frontend)

	mkdir -p /etc/modules-load.d
	{
		echo "# Generated by amd-hsmp-dkms."
		echo "hsmp_common"
		echo "$module"
	} > "$MODULES_LOAD_CONF"

	if command -v modprobe >/dev/null 2>&1; then
		modprobe "$module" >/dev/null 2>&1 || true
	fi
}

case "$1" in
	configure)
		postinst_found=0
		for DKMS_POSTINST in /usr/lib/dkms/common.postinst /usr/share/$DKMS_PACKAGE_NAME/postinst; do
			if [ -f "$DKMS_POSTINST" ]; then
				"$DKMS_POSTINST" "$DKMS_NAME" "$DKMS_VERSION" "/usr/share/$DKMS_PACKAGE_NAME" "" "$2"
				postinst_found=1
				break
			fi
		done

		if [ "$postinst_found" -eq 0 ]; then
			echo "ERROR: DKMS version is too old and $DKMS_PACKAGE_NAME was not built with legacy DKMS support."
			exit 1
		fi

		configure_module_autoload
		;;
esac
